{"type": "tool_call", "callId": "call_e55e6a50c18c4aedb9d9d622", "tool": "write", "input": {"content": "export function buildCatalog(records, { now }) {\n  const nowTime = Date.parse(now);\n  return records\n    .filter((record) => record.draft !== true)\n    .filter((record) => {\n      const publishedTime = Date.parse(record.publishedAt);\n      return Number.isFinite(publishedTime) && publishedTime <= nowTime;\n    })\n    .map((record) => {\n      const filename = record.source.split(/[\\\\/]/).at(-1);\n      const slug = filename.replace(/\\.md$/, '');\n      return {\n        title: record.title,\n        slug,\n        url: `/articles/${slug}`,\n        publishedAt: record.publishedAt,\n      };\n    })\n    .sort((a, b) => Date.parse(b.publishedAt) - Date.parse(a.publishedAt));\n}\n", "file_path": "<workspace>/src/catalog.js"}}
