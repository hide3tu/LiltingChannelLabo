{"type": "tool_call", "callId": "call_9568f127f1e84cab8e70d343", "tool": "write", "input": {"content": "export function buildCatalog(records, { now }) {\n  const nowMs = Date.parse(now);\n  return records\n    .filter((record) => record.draft !== true)\n    .filter((record) => {\n      const publishedMs = Date.parse(record.publishedAt);\n      return Number.isFinite(publishedMs) && publishedMs <= nowMs;\n    })\n    .sort((a, b) => Date.parse(b.publishedAt) - Date.parse(a.publishedAt))\n    .map((record) => {\n      const filename = record.source.split(/[/\\\\]/).at(-1);\n      const slug = filename.replace(/\\.md$/, '');\n      return {\n        title: record.title,\n        slug,\n        url: `/articles/${slug}`,\n        publishedAt: record.publishedAt,\n      };\n    });\n}\n", "file_path": "<workspace>/src/catalog.js"}}
