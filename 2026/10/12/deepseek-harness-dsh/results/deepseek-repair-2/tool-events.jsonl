{"type": "tool_call", "callId": "call_0d1a07cae8a54cc68148ff8c", "tool": "write", "input": {"file_path": "src/catalog.js", "content": "export function buildCatalog(records, { now }) {\n  const nowMs = Date.parse(now);\n\n  return records\n    .filter((record) => record.draft !== true)\n    .filter((record) => {\n      const publishedMs = Date.parse(record.publishedAt);\n      return (\n        Number.isFinite(publishedMs) &&\n        Number.isFinite(nowMs) &&\n        publishedMs <= nowMs\n      );\n    })\n    .map((record) => ({\n      record,\n      publishedMs: Date.parse(record.publishedAt),\n    }))\n    .sort((a, b) => b.publishedMs - a.publishedMs)\n    .map(({ record }) => {\n      const slug = record.source\n        .split(/[\\\\/]/)\n        .at(-1)\n        .replace(/\\.md$/, '');\n      return {\n        title: record.title,\n        slug,\n        url: `/articles/${slug}`,\n        publishedAt: record.publishedAt,\n      };\n    });\n}"}}
{"type": "tool_result", "callId": "call_0d1a07cae8a54cc68148ff8c", "status": "completed"}
