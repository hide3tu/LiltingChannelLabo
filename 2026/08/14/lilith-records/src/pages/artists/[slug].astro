---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { artists, getArtistBySlug } from '../../data/artists';

export function getStaticPaths() {
  return artists.map((artist) => ({
    params: { slug: artist.slug },
    props: { artist },
  }));
}

const { slug } = Astro.params;
const artist = getArtistBySlug(slug!);

if (!artist) {
  return Astro.redirect('/artists/');
}
---

<BaseLayout
  title={artist.name}
  description={`${artist.name}（${artist.nameJa}）- ${artist.description}`}
  ogImage={artist.image}
  breadcrumbs={[
    { name: 'Artists', url: '/artists/' },
    { name: artist.name, url: `/artists/${artist.slug}/` },
  ]}
  schemaType="Person"
  schemaData={{
    name: artist.name,
    description: artist.description,
    jobTitle: artist.role,
    memberOf: {
      '@type': 'MusicGroup',
      name: 'Lilith-4',
    },
  }}
>
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/artists/">← Back to Artists</a>
      </nav>
      <h1>{artist.name}</h1>
      <p class="page-subtitle">{artist.nameJa} | {artist.role}</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="artist-detail">
        <div class="artist-image-wrapper">
          <img src={artist.image} alt={artist.name} class="artist-image-large" />
          <div class="artist-overlay">
            <span class="artist-label">Artist Profile</span>
          </div>
        </div>
        <div class="artist-content">
          <div class="artist-block">
            <h2>Profile</h2>
            <p>{artist.description}</p>
          </div>

          <div class="artist-block">
            <h2>Features</h2>
            <ul class="features-list">
              {artist.features.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    font-size: 0.875rem;
    opacity: 0.7;
    border-bottom: 1px solid var(--color-border);
    transition: border-color 0.2s, color 0.2s;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .page-subtitle {
    margin-top: var(--space-xs);
    font-size: 1.125rem;
    opacity: 0.7;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .artist-detail {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: var(--space-lg);
  }

  .artist-image-wrapper {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    border: 2px solid var(--color-border);
  }

  .artist-image-large {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .artist-overlay {
    position: absolute;
    bottom: var(--space-sm);
    left: var(--space-sm);
    background-color: var(--color-bg);
    padding: 0.75rem 1.5rem;
    border: 2px solid var(--color-border);
  }

  .artist-label {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }

  .artist-block {
    margin-bottom: var(--space-lg);
  }

  .artist-block h2 {
    font-size: 1.75rem;
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 2px solid var(--color-border);
    letter-spacing: -0.02em;
  }

  .artist-block p {
    line-height: 1.8;
    font-size: 1rem;
  }

  .features-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .features-list li {
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .features-list li:last-child {
    border-bottom: none;
  }

  @media (max-width: 768px) {
    .artist-detail {
      grid-template-columns: 1fr;
    }

    .artist-image-large {
      max-width: 400px;
      margin: 0 auto;
    }
  }
</style>
