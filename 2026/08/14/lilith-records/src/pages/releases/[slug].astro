---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { releases, getReleaseBySlug } from '../../data/releases';

export function getStaticPaths() {
  return releases.map((release) => ({
    params: { slug: release.slug },
    props: { release },
  }));
}

const { slug } = Astro.params;
const release = getReleaseBySlug(slug!);

if (!release) {
  return Astro.redirect('/releases/');
}

const schemaType = release.type === 'album' ? 'MusicAlbum' : 'MusicRecording';
const schemaData: any = {
  name: release.title,
  byArtist: {
    '@type': 'MusicGroup',
    name: release.artist,
  },
  datePublished: release.releaseDate,
};

if (release.type === 'album') {
  schemaData.track = {
    '@type': 'ItemList',
    itemListElement: release.tracks.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'MusicRecording',
        name: t.title,
        duration: `PT${t.duration.replace(':', 'M')}S`,
      },
    })),
  };
}
---

<BaseLayout
  title={release.title}
  description={`${release.artist} - ${release.title}（${new Date(release.releaseDate).toLocaleDateString('ja-JP')}）`}
  ogImage={release.coverImage}
  breadcrumbs={[
    { name: 'Releases', url: '/releases/' },
    { name: release.title, url: `/releases/${release.slug}/` },
  ]}
  schemaType={schemaType}
  schemaData={schemaData}
>
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/releases/">← Back to Releases</a>
      </nav>
      <h1>{release.title}</h1>
      <p class="page-subtitle">{release.artist}</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="release-detail">
        <div class="release-cover-large">
          <img src={release.coverImage} alt={release.title} class="cover-image" />
        </div>
        <div class="release-content">
          <div class="release-meta-block">
            <div class="meta-item">
              <span class="meta-label">Type</span>
              <span class="meta-value">
                {release.type === 'album' ? 'Album' : release.type === 'single' ? 'Single' : 'Mini Album'}
              </span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Release Date</span>
              <span class="meta-value">{new Date(release.releaseDate).toLocaleDateString('ja-JP')}</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Catalog No.</span>
              <span class="meta-value">{release.catalogNumber}</span>
            </div>
          </div>

          <div class="release-block">
            <h2>Tracklist</h2>
            <ol class="tracklist">
              {release.tracks.map((track, i) => (
                <li>
                  <span class="track-number">{String(i + 1).padStart(2, '0')}</span>
                  <span class="track-title">{track.title}</span>
                  <span class="track-duration">{track.duration}</span>
                </li>
              ))}
            </ol>
          </div>

          <div class="release-block">
            <h2>Listen</h2>
            <div class="release-links">
              {release.links.spotify && (
                <a href={release.links.spotify} target="_blank" rel="noopener" class="link-button">
                  Spotify
                </a>
              )}
              {release.links.youtube && (
                <a href={release.links.youtube} target="_blank" rel="noopener" class="link-button">
                  YouTube
                </a>
              )}
              {release.links.appleMusic && (
                <a href={release.links.appleMusic} target="_blank" rel="noopener" class="link-button">
                  Apple Music
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: var(--space-sm);
  }

  .breadcrumb a {
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .page-subtitle {
    margin-top: var(--space-xs);
    font-size: 1.25rem;
    opacity: 0.7;
  }

  .release-detail {
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: var(--space-lg);
  }

  .release-cover-large {
    aspect-ratio: 1;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .cover-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .release-meta-block {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-md);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }

  .meta-value {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
  }

  .release-block {
    margin-bottom: var(--space-md);
  }

  .release-block h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .tracklist {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: track;
  }

  .tracklist li {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    gap: var(--space-sm);
    padding: var(--space-xs) 0;
    border-bottom: 1px solid var(--color-border);
    align-items: center;
  }

  .tracklist li:last-child {
    border-bottom: none;
  }

  .track-number {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    opacity: 0.5;
  }

  .track-title {
    font-size: 1rem;
  }

  .track-duration {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    opacity: 0.7;
  }

  .release-links {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .link-button {
    font-size: 0.875rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--color-border);
    transition: background-color 0.2s, color 0.2s;
  }

  .link-button:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
  }

  .placeholder-image {
    width: 100%;
    height: 100%;
    background-color: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-bg);
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .release-detail {
      grid-template-columns: 1fr;
    }

    .release-cover-large {
      max-width: 400px;
      margin: 0 auto;
    }

    .release-meta-block {
      grid-template-columns: 1fr;
    }
  }
</style>
